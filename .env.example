# Copy to .env.local for local development. Never commit a filled-in copy.
#
# Locally, the Supabase values are printed by `supabase status -o env` after
# `supabase start` — API_URL, ANON_KEY and SERVICE_ROLE_KEY respectively. The tests
# read them from the running stack themselves and need no .env file.

# `EXPECTED_SCHEMA_MIGRATIONS` is deliberately not here. `next.config.ts` bakes it in
# from `supabase/migrations/` at build time so /api/health can spot a database behind
# this build; setting it by hand anywhere would restore the very thing it replaced — a
# version somebody has to remember to bump.

# Supabase — Postgres, Auth, Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Lets a request pin the run instant with the `x-run-instant` header (ADR-0010).
# Development and CI only — it is ignored in production builds whatever it says.
ALLOW_RUN_INSTANT_HEADER=true

# The bearer token Vercel Cron signs its daily call with. Vercel sets it on the
# deployment and sends `Authorization: Bearer $CRON_SECRET`; /api/cron/daily refuses
# every caller without it, including when it is unset — the endpoint's whole capability
# is posting into the company's WeCom group.
CRON_SECRET=

# The app's own public origin — absolute, https, no trailing slash and no path. It is the
# only thing that lets a group message carry a link into the app: every URL is built
# server-side during the daily cron run, where there is no request to read a Host header
# off. `NEXT_PUBLIC_` deliberately not, because the browser has no use for it.
#
# Unset, every message still sends — reminders are the product, and a run suppressed over
# a missing config line would cause the very failure this app exists to prevent — but they
# arrive telling people to go into the system with no way in, which is what #59 was filed
# for. So the cost is paid at deployment instead: /api/health answers `no-app-origin` and
# the deployment gate goes red until it is set. Note that a variable added after a build
# needs a redeploy before the running deployment sees it.
APP_ORIGIN=

# The Beta Code the signup screen at `/signup` asks for, where an organisation and its
# first Org Admin are created (ADR-0039). One shared string handed to each invited client
# during the closed beta, not a per-client token. Unset means the screen is closed, which
# is the safe direction for that mistake to fail in — and every preview deployment shares
# production's database. Rotate it by changing this value and redeploying.
#
# It is the beta's guest list and not org isolation: a stranger holding it gets an empty
# organisation of their own and nothing of anybody else's, because the grant on `orgs` and
# the policy on `memberships` are what keep them out, not this string.
SIGNUP_CODE=

# The email transport (ADR-0034): Resend, provisioned through the Vercel Marketplace
# (`vercel integration add resend/resend-email`), which supplies the key on the
# deployment. Server-side only, never `NEXT_PUBLIC_`. Unset, the app runs and the tests
# stub the boundary — but the morning run throws at its first real send rather than
# reporting success, so /api/health answers `no-email-config` and the deployment gate
# goes red until both of these are set.
RESEND_API_KEY=

# The sender every email leaves as — an address on the company's own verified domain
# (SPF and DKIM live in Cloudflare, where this project's DNS is), or the mail is filed
# as spam. Until the domain verifies, Resend delivers only to the account owner's own
# address: enough to test with, not enough to ship.
# e.g. Awardley <reminders@notify.awardley.com>
EMAIL_FROM=
