# The marketing site's five variables. All five are set on the Vercel project
# `awardley-landing`, not on the app's project — the two share nothing.
#
# Missing any of them fails closed: the form still answers "check your inbox", the
# server logs which one is unset, and no address is collected. That is deliberate (a
# stack trace on a marketing page tells a stranger which provider we use) and it is the
# reason the first deploy is checked by signing up once and watching the inbox.

# Resend, the same account the app sends Reminders through. Needs permission to send
# from the verified domain and to write to the Audience below.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The Resend Audience that *is* the waiting list. There is no table anywhere: a
# confirmed address is added here and nowhere else.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# The HMAC key over `email|expiresAt` in the confirmation link. Any long random string —
# `openssl rand -base64 48` — and rotating it invalidates every link still in flight,
# which is at most 48 hours' worth.
WAITING_LIST_SECRET=change-me-to-something-long-and-random

# Where a reply to the confirmation email lands. A mailbox Mike actually reads: the
# From address (hello@awardley.com) is the verified sender, not necessarily an inbox.
REPLY_TO=mike@example.com

# The origin the confirmation link is built against. No trailing slash needed — one is
# stripped if it is there. Production is https://awardley.com; a preview deploy wants
# its own URL here, or every link in it points at production.
SITE_ORIGIN=https://awardley.com
